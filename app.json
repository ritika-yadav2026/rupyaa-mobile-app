{
  "expo": {
    "name": "Rupyaa",
    "slug": "rupyaa-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rupyaa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rupyaa.loan",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "FirebaseInAppMessagingDisplayEnabled": true,
        "NSCameraUsageDescription": "Rupyaa needs camera access to capture your selfie and scan documents for identity verification.",
        "NSLocationWhenInUseUsageDescription": "Rupyaa uses your location to verify serviceability and confirm your address during the KYC process.",
        "NSContactsUsageDescription": "Rupyaa needs access to your device contacts so you can invite friends.",
        "NSPhotoLibraryUsageDescription": "Rupyaa needs access to your photo library so you can upload documents for your loan application.",
        "NSUserTrackingUsageDescription": "We use this identifier to show you personalised offers and to measure the effectiveness of our ads.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.520032386050-ksc98gssjndoifj6vmu70j5fcijiv7n1"
            ]
          }
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 220
        }
      ],
      [
        "freerasp-react-native/app.plugin.js",
        {
          "android": {
            "minSdkVersion": "24"
          }
        }
      ],
      [
        "./plugins/withGoogleTagManager.js",
        {
          "androidContainerId": "GTM-NQTM5TJ9",
          "iosContainerId": "GTM-NQTM5TJ9",
          "tagManagerVersion": "18.0.1",
          "androidContainerFile": "./assets/gtm-containers/GTM-NQTM5TJ9.json",
          "iosContainerFile": "./assets/gtm-containers/GTM-NQTM5TJ9.json"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Rupyaa needs access to your device contacts so you can invite friends."
        }
      ],
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "otaUpdateNumberDev": "1",
      "otaUpdateNumberProd": "1",
      "versionDev": "1.0.0",
      "versionProd": "1.0.0",
      "versionProdIos": "1.0.0",
      "isDevelopment": true,
      "otaUpdateNumber": "1",
      "environment": "production",
      "disableCrashlytics": false,
      "router": {},
      "version": "1.0.38",
      "eas": {
        "projectId": "47dfc90e-0f7d-40af-a562-951aca9e89d8"
      }
    },
    "android": {
      "package": "com.rupyaa.loan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "owner": "omnistack-innovation",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
